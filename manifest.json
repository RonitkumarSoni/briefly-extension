{
  "manifest_version": 3,
  "name": "Briefly — Article Summarizer",
  "version": "1.5.1",
  "description": "Clear, source-aware summaries of the article you're reading.",
  "minimum_chrome_version": "116",
  "permissions": ["tabs", "scripting", "storage", "sidePanel"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": { "service_worker": "background.js" },
  "side_panel": { "default_path": "panel.html" },
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "action": { "default_title": "Open Briefly", "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png" } }
}
